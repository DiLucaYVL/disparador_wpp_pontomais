# URL base da Evolution API (externa)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_INSTANCE=seu-instance
EVOLUTION_TOKEN=seu-token

# Planilha de n?meros de equipes (CSV p?blico ou Google Sheets API)
PLANILHA_EQUIPES_URL=
# Opcional: fallback via Google Sheets API (usa a mesma service account)
PLANILHA_EQUIPES_SHEET_ID=
PLANILHA_EQUIPES_WORKSHEET=
PLANILHA_EQUIPES_GID=

# Configura??es do banco de dados MySQL
DB_HOST=192.168.99.50
DB_PORT=3306
DB_NAME=enviodp
DB_USER=seu-usuario
DB_PASSWORD=sua-senha

# Google Sheets
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Dados
# Caminho para o arquivo JSON da service account (opcional)
GOOGLE_SHEETS_CREDENTIALS_FILE=
# Ou defina o JSON completo da service account (opcional)
GOOGLE_SHEETS_CREDENTIALS_JSON=
